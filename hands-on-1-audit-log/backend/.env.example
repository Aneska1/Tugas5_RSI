# Konfigurasi Backend
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# SQL Server - Windows Authentication
# Pastikan ODBC Driver 18 for SQL Server sudah terpasang.
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=review_kantin
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Autentikasi (cookie httpOnly + JWT HS256)
# Ganti dengan secret acak minimal 32 karakter.
JWT_SECRET=ubah_dengan_secret_acak_minimal_32_karakter
JWT_EXPIRES_IN=1d
AUTH_COOKIE_NAME=kantin_session_ho2
BCRYPT_SALT_ROUNDS=10